{
  "name": "dsh-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "DeepSeek Harness desktop app (Electron wrapper around the official dsh web UI)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deepseek.dsh-desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "update-preload.js",
      "package.json",
      "build/icon.png",
      "build/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis",
        "msi"
      ],
      "artifactName": "DeepSeek-Harness-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Portable-${version}-${arch}.${ext}"
    }
  }
}
